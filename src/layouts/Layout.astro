---
import "../css/css.css";
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="The better ReX Compoents Library" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/dark.min.css"
    />
    <script type="module" is:inline>
      import hljs from "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/es/highlight.min.js";
      hljs.highlightAll();
    </script>
  </head>
  <body>
    <script>
      import "../components/lib/translate";
    </script>
    <slot />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  html {
    height: 100dvh;
    width: 100dvw;
    font-family: var(--rex-font);
    font-size: 16px;
    background-color: var(--mainBG);
    color: var(--mainText);
    overflow: hidden;
  }
  a {
    color: var(--detailsLink);
  }
  h1,
  h2,
  h3,
  h4 {
    margin-bottom: 0.5em;
  }
  h1 {
    font-size: 1.5rem;
  }
  h2 {
    font-size: 1.35rem;
  }
  h3 {
    font-size: 1.1rem;
  }
  h4 {
    font-size: 1rem;
  }
  .noBotMargin {
    margin-bottom: 0;
  }
  .noTopMargin {
    margin-top: 0;
  }
  hr {
    border: 0;
    height: 1px;
    background-color: var(--accent);
    margin: 1rem 2rem;
  }
  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
    font-size: 0.75rem;
    border-radius: var(--borderRadius);
  }
  pre {
    margin: 0;
  }
  h4 small,
  h3 small {
    opacity: 0.7;
    font-weight: normal;
  }
  em.alert {
    display: block;
    background-image: url("/danger.svg");
    background-repeat: no-repeat;
    background-position: 1rem center;
    font-size: 0.9rem;
    background-size: 1rem;
    margin: 1rem;
    padding: 1rem;
    padding-left: 2.5rem;
    border: 1px dashed var(--alert);
    border-radius: var(--borderRadius);
  }
  body {
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 40px 1fr;
    width: 100dvw;
    height: 100dvh;
    transition: all 0.3s;
    &:has(nav.open) {
      grid-template-columns: 13.125rem 1fr;
      nav .open {
        transform: rotate(0deg);
      }
    }
  }
  nav ul {
    list-style-type: none;
    margin: 0;
    padding: 1rem 0;
    min-width: max-content;
  }
  nav {
    display: flex;
    flex-direction: row-reverse;
    position: relative;
    padding: 0;
    background: var(--navBG);
    text-transform: uppercase;
    font-size: 0.8rem;
    transition: all 0.3s;
  }
  nav [data-selected="true"] {
    color: var(--accent);
  }

  nav li {
    color: var(--mainText);
    user-select: none;
    cursor: pointer;
    padding: 0.3rem 1rem;
    padding-left: 1rem;
    transition: all 0.3s;
  }

  nav .gfx {
    * {
      user-select: none;
    }
    display: flex;
    flex-direction: row;
    align-items: end;
    padding: 1rem 0rem;
    padding-right: 0.4rem;
    background-color: var(--section1);
    font-weight: bold;
    font-size: 2rem;
    line-height: 2.1rem;
    color: var(--navBG);

    writing-mode: vertical-lr;
    &:hover {
      cursor: pointer;
    }
    .open {
      writing-mode: initial;
      font-size: 1rem;
      transition: all 0.3s;
      transform: rotate(180deg);
      color: var(--accent);
    }
    .text {
      flex: 1;
      text-align: center;
    }
  }

  main {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    overflow-x: hidden;
    overflow-y: scroll;
    padding: 0;
    background-color: var(--contentBG);
    padding: 1rem;
  }
  .props-table input,
  .props-table select {
    padding: 0.3rem 0.6rem;
    border-radius: calc(var(--borderRadius) / 2);
    border: 1px solid var(--inputBorder);
    width: 100%;
    color: var(--accent);
  }
  .example-wrap code {
    display: block;
    padding: 0.3rem 0.6rem;
    margin-bottom: 0.5rem;
    color: var(--accentLight);
    background-color: var(--codeBG);
    border-radius: calc(var(--borderRadius) / 2);
  }
  .props-table {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-evenly;
    padding-bottom: 2rem;
    .prop {
      width: calc(25% - 1rem);
      min-width: 10rem;
    }
  }
  .example-wrap .prop .name {
    padding-left: 0.5rem;
    padding-bottom: 0.1rem;
    font-size: 0.85rem;
  }
  .example-wrap .prop-output h3 {
    margin-top: 0;
  }
  .example-wrap .prop-output {
    padding: 1rem;
    background-color: var(--insertBG);
    border-radius: var(--borderRadius);
  }
  .demo-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem;
    background-color: var(--section1);
    border-radius: var(--borderRadius);
  }
  .demo-wrap::after {
    content: "DEMO";
    position: absolute;
    top: 0.3rem;
    left: 0.6rem;
    font-weight: bold;
    opacity: 0.2;
  }
  #outputbox legend {
    grid-column: 1/3;
    position: absolute;
    top: -0.8rem;
    left: 0.5rem;
    background-color: var(--insertBG);
  }
  #outputbox .top,
  #outputbox .bot {
    display: flex;
    gap: 0.3rem;
  }
  #outputbox .name {
    padding: 0.2rem 0.4rem;
    background-color: var(--mainBG);
    color: var(--accent);
    border-radius: calc(var(--borderRadius) / 2);
  }
  #outputbox .value {
    padding: 0.2rem 0.4rem;
  }
  #outputbox {
    margin-top: 1.5rem;
    position: relative;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: auto 1fr;
    border: 1px dashed var(--accent);
    border-radius: var(--borderRadius);
    padding: 0.6rem;
    padding-top: 0.8rem;
    min-height: 2.625rem;
    display: grid;
    gap: 0.5rem;
  }
  .example-wrap {
    padding: 1rem;
    background-color: var(--section1);
    border-radius: var(--borderRadius);
  }
  section.data div.title {
    grid-column: 1/3;
    padding: 0;
  }
  @media screen and (max-width: 900px) {
    .data .value {
      grid-column: 1/3;
    }
    section.data .name {
      justify-content: center !important;
    }
  }
  section.data div {
    padding: 0.2rem 0.6rem;
  }
  section.data .name {
    background-color: var(--accent);
    border-radius: calc(var(--borderRadius) / 2);
    color: white;
    display: flex;
    align-items: center;
    justify-content: right;
  }

  section.data {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.1rem;
  }
  section.highlight h3 {
    padding-left: 0;
    color: var(--highlightHeading);
  }
  section.highlight h4 {
    color: var(--accent);
  }

  section.highlight .sub {
    padding: 0 1rem;
  }
  section.highlight .details {
    background-color: var(--detailsBG);
    color: var(--detailsText);
    padding: 1rem;
    border-radius: var(--borderRadius);
  }
  section.details h3 {
    color: var(--detailsHeading);
  }
  section.highlight {
    background-color: var(--section1);
    padding: 1rem;
    border-radius: var(--borderRadius);
  }
  ::backdrop {
    background-color: #000;
    opacity: 0.8;
  }
  .icon-btn {
    background-color: transparent;
    border: 0;
    margin: 0;
    padding: 0;
    img svg {
      stroke: pink;
    }
  }
  em {
    color: var(--accent);
  }
</style>
