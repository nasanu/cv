---
export const title = "Language Selector";
export const jsFile = "langSelect.js";
---

<h1>{title}</h1>

<div class="desc">
  This component is allows users to change the displayed language. It works in
  conjunction with the <a href="#Translate">translate component</a> which is required
  to be setup first.
  <br /><br />
</div>

<div class="demo-wrap">
  <fn-langselect></fn-langselect>
</div>
<h3>In Code</h3>
<div class="code-wrap">
  <pre><code class="usage language-javascript">
    {`
  // import the component
  import {fn-langselect} from TBA;
  
  //use it in your HTML
  <fn-langselect>someString</fn-langselect>
  `}
  </code></pre>
  <br />
  <section class="highlight">
    <h3>How it works</h3>
  </section>
</div>

<script>
  import "../lib/langSelect";
</script>
