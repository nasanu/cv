---
interface Props {
  id: string;
}
const { id } = Astro.props;
export const title = "Dialog";
---

<dialog id={id}>
  <code class="body">
    <slot />
  </code>
  <button autofocus>X</button>
</dialog>

<script define:vars={{ id }}>
  document
    .querySelector("dialog#" + id + " button")
    ?.addEventListener("click", () => {
      document.querySelector("dialog#" + id)?.close();
    });

  document.querySelector("dialog#" + id).addEventListener("click", (event) => {
    if (event.target.id === id) {
      document.querySelector("dialog#" + id)?.close();
    }
  });
</script>

<style>
  dialog[open] {
    border-radius: 1rem;
    border: 0;
    max-width: 90vw;
    padding: 0;
    background-color: var(--dropDownBG);
    &::-webkit-scrollbar {
      width: 0.5em;
    }

    &::-webkit-scrollbar-track {
      box-shadow: none;
    }

    &::-webkit-scrollbar-thumb {
      background-color: var(--accent);
      outline: 0px solid slategrey;
      border-radius: 1rem;
    }

    button {
      position: absolute;
      top: 1rem;
      right: 0.5rem;
      background-color: transparent;
      border: 0;
      outline: none;
      cursor: pointer;
      font-size: 1.2rem;
      font-weight: bold;
    }
    code.body {
      pre {
        margin: 3rem 2rem;
        white-space: pre-wrap;
        word-wrap: break-word;
      }
      position: relative;
    }
  }
</style>
